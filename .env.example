# Copy this file to ".env" and fill in real values for local development.
# IMPORTANT: Do not commit ".env" with real secrets to git.

ENVIRONMENT=local

# Redis connection string for task queues and short-term / episodic cache.
# Example (Docker / local): redis://localhost:6379/0
REDIS_URL=

# Weaviate base URL for vector / semantic memory.
# Example: http://localhost:8080 or https://your-weaviate-instance
WEAVIATE_URL=

# Weaviate API key used to authenticate requests to the Weaviate instance.
# Keep this secret and only set it in your local ".env".
WEAVIATE_API_KEY=

# Local MCP server URL used by Chimera agents to access tools and resources.
# Example: http://localhost:9000
MCP_SERVER_URL=

# Coinbase AgentKit API key name / identifier configured in your Coinbase account.
# Used by the planner / CFO judge to access non-custodial wallets via AgentKit.
COINBASE_API_KEY_NAME=

# Coinbase AgentKit API private key (PEM or key string as required by AgentKit).
# This is highly sensitive; never commit real values and store only in ".env" or a secret manager.
COINBASE_API_PRIVATE_KEY=

# NOTE: All values above are placeholders. Do not commit real values.
