###############################
# Project Chimera – .gitignore
# Standard Python + tooling
###############################

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
*.egg-info/
dist/
build/
site/

# Logs
*.log

# Unit test / coverage
.pytest_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# Ruff cache
.ruff_cache/

# Environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Frontend dependencies/build
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Editor / IDE metadata
.idea/
.vscode/

# OS-specific files
.DS_Store

# Cursor-specific cache
.cursor/cache/
